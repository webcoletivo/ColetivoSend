# ColetivoSend — variáveis de ambiente
# Copie para .env e preencha. Nunca versione o .env.
# Produção (Coolify, app "send"): as mesmas chaves abaixo.

# ----- Banco (Prisma / PostgreSQL) -----
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"
# Opcional: conexão direta (sem pooler) usada pelas migrations
# DIRECT_URL=

# ----- Unificação (plataforma Grupo Coletivo) -----
# URL da plataforma para validar a sessão SSO (server-side)
PLATFORM_URL=http://localhost:3000
# Caminho onde este app é servido no domínio unificado
NEXT_PUBLIC_BASE_PATH=/send
# URL pública do app. Produção: https://app.grupocoletivo.com.br/send
NEXTAUTH_URL=http://localhost:3002/send
# Assina a sessão local (JWT). Gerar: openssl rand -base64 32
NEXTAUTH_SECRET=
# Segredo compartilhado com a plataforma (header x-servico-segredo). Mesmo valor da plataforma.
NOTIFY_SERVICE_SECRET=

# ----- Storage -----
# "s3" (produção) ou "local"
STORAGE_TYPE=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: endpoint S3-compatível (R2, MinIO…)
# AWS_ENDPOINT=

# ----- Upload -----
# NEXT_PUBLIC_* entram no build (o navegador lê): mudou, precisa de deploy.
NEXT_PUBLIC_UPLOAD_MAX_SIZE_MB=10240
NEXT_PUBLIC_UPLOAD_MAX_FILES=2000
# NEXT_PUBLIC_UPLOAD_CHUNK_SIZE_MB=20
# NEXT_PUBLIC_UPLOAD_MAX_CONCURRENT_CHUNKS=
# NEXT_PUBLIC_UPLOAD_MAX_RETRIES=
# Lado do servidor (sessão de upload por partes)
# UPLOAD_CHUNK_SIZE_MB=20
# UPLOAD_SESSION_EXPIRY_HOURS=24

# ----- Cron (/api/cron/cleanup, Bearer token) -----
CRON_SECRET=

# ----- Opcionais -----
# LOG_LEVEL=debug

# Removidas em 24/09/2026 (o código não lê mais): GOOGLE_CLIENT_*, SMTP_*,
# UPLOAD_MAX_*, GUEST_*, NEXT_PUBLIC_GUEST_*.
